<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup Condition="'$(LocalAmongUsPath)' != ''">
    <Reference Include="$(LocalAmongUsPath)/BepInEx/interop/*.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(LocalAmongUsPath)/BepInEx/core/SemanticVersioning.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;runtime-smoke/**/*.cs" />
    <!-- BepInEx's embedded host already loads the .NET 6 framework assemblies.
         Newer Roslyn releases require Immutable/Metadata 7 or 8 and cannot bind
         to those framework assemblies, even when their DLLs ship beside us. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="[4.3.1]" />
  </ItemGroup>
  <Target Name="RequireLocalAmongUsPath" BeforeTargets="ResolveReferences" Condition="'$(LocalAmongUsPath)' == ''">
    <Error Text="Build with -p:LocalAmongUsPath=D:\Game\20260929 to use the installed game interop assemblies." />
  </Target>
</Project>
